{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "branchPrefix": "renovate/",
  "dependencyDashboard": true,
  "prCreation": "approval",
  "semanticCommits": "enabled",
  "schedule": ["before 6am"],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "nix": {
    "enabled": false
  }
}
