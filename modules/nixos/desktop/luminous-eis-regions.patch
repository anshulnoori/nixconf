+#[cfg(test)]
+mod tests {
+    use super::*;
+    use reis::{ei, event::EiEvent};
+    use std::os::unix::net::UnixStream;
+
+    #[test]
+    fn absolute_devices_advertise_regions_before_done() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("eis");
+        let listener = eis::Listener::bind(&path).unwrap();
+        let (sender, _) = start();
+        sender
+            .send(EisServerMsg::NewListener(
+                listener,
+                "region-test".into(),
+                Some(DeviceRegion { width: 1536, height: 864, scale: 1.25 }),
+            ))
+            .unwrap();
+        let context = ei::Context::new(UnixStream::connect(path).unwrap()).unwrap();
+        let (_, events) = context
+            .handshake_blocking("region-test", ei::handshake::ContextType::Sender)
+            .unwrap();
+        let mut devices = 0;
+        for event in events {
+            match event.unwrap() {
+                EiEvent::SeatAdded(event) => {
+                    event.seat.bind_capabilities(
+                        reis::event::DeviceCapability::PointerAbsolute
+                            | reis::event::DeviceCapability::Touch,
+                    );
+                    context.flush().unwrap();
+                }
+                EiEvent::DeviceAdded(event) => {
+                    assert_eq!(event.device.regions().len(), 1);
+                    let region = &event.device.regions()[0];
+                    assert_eq!((region.x, region.y), (0, 0));
+                    assert_eq!((region.width, region.height), (1536, 864));
+                    assert_eq!(region.scale, 1.25);
+                    devices += 1;
+                    if devices == 2 {
+                        return;
+                    }
+                }
+                _ => {}
+            }
+        }
+        panic!("EIS connection ended before both absolute devices appeared");
+    }
+}
