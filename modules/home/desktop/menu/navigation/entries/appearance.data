{
  id = "appearance";
  text = "Appearance";
  children = [
    {
      id = "background";
      text = "Background";
      keywords = ["wallpaper"];
      submenu = "nixconf-background";
    }
    {
      id = "stylix";
      text = "Stylix";
      keywords = ["theme" "colors"];
      action = "nixconf-edit stylix";
    }
    {
      id = "font";
      text = "Font";
      keywords = ["typeface"];
      action = "nixconf-edit font";
    }
    {
      id = "hyprland";
      text = "Hyprland";
      keywords = ["compositor" "window manager"];
      action = "nixconf-edit hyprland";
    }
    {
      id = "waybar";
      text = "Waybar";
      keywords = ["bar"];
      action = "nixconf-edit waybar";
    }
    {
      id = "lock-screen";
      text = "Lock Screen";
      keywords = ["hyprlock"];
      action = "nixconf-edit lock-screen";
    }
    {
      id = "screensaver";
      text = "Screensaver";
      action = "nixconf-edit screensaver";
    }
  ];
}
