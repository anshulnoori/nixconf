+bool Item::updateText() {
+  // The producer atomically replaces this small JSON file. Keep the last valid
+  // state during replacement/startup; SNI still owns this widget's lifecycle.
+  std::ifstream input(text_file_);
+  if (!input) return true;
+  try {
+    const std::string contents((std::istreambuf_iterator<char>(input)), {});
+    const auto state = util::JsonParser().parse(contents);
+    if (!state["text"].isString() || !state["tooltip"].isString()) return true;
+    text_label_.set_text(state["text"].asString());
+    event_box.set_tooltip_text(state["tooltip"].asString());
+    // Keep event activity separate from the SNI's own Active/Passive classes.
+    auto style = text_label_.get_style_context();
+    if (state["class"].asString() == "active") {
+      style->add_class("active");
+    } else {
+      style->remove_class("active");
+    }
+  } catch (const std::exception&) {
+    // Invalid or partially written state must not break the tray/menu.
+  }
+  return true;
+}
