+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MENU: &str = r#"
+menu:
+  - key: w
+    desc: Windows & <tools>
+    submenu:
+      - key: r
+        desc: Resize
+        submenu:
+          - key: h
+            desc: Shrink
+            cmd: "true"
+  - key: a
+    desc: Apps
+    submenu:
+      - key: t
+        desc: Terminal
+        cmd: "true"
+"#;
+
+    #[test]
+    fn breadcrumb_tracks_initial_keys_parent_and_siblings() {
+        let config: Config = serde_yaml::from_str(&format!("show_breadcrumbs: true\n{MENU}")).unwrap();
+        let mut menu = Menu::new(&config).unwrap();
+        assert!(menu.pages[0].breadcrumb.is_none());
+        menu.navigate_to_key_sequence("w r").unwrap();
+        let page = &menu.pages[menu.cur_page];
+        let header = page.breadcrumb.as_ref().unwrap();
+        assert_eq!(header.layout.text(), "Windows & <tools> » Resize");
+        assert!(menu.width(&config) >= header.width + 2.0 * (config.padding() + config.border_width));
+        assert!(menu.height(&config) >= header.height + config.padding() + page.item_height);
+        let Action::Submenu(parent) = menu.get_action(ModifierState::default(), xkb::Keysym::BackSpace).unwrap() else { panic!("missing parent") };
+        menu.set_page(parent);
+        assert_eq!(menu.pages[menu.cur_page].breadcrumb.as_ref().unwrap().layout.text(), "Windows & <tools>");
+        menu.set_page(0);
+        menu.navigate_to_key_sequence("a").unwrap();
+        assert_eq!(menu.pages[menu.cur_page].breadcrumb.as_ref().unwrap().layout.text(), "Apps");
+    }
+
+    #[test]
+    fn old_configuration_has_no_headers_or_color_overrides() {
+        let config: Config = serde_yaml::from_str(MENU).unwrap();
+        assert!(!config.show_breadcrumbs);
+        assert!(config.key_color.is_none() && config.desc_color.is_none());
+        assert!(config.group_color.is_none() && config.separator_color.is_none());
+        let menu = Menu::new(&config).unwrap();
+        assert!(menu.pages.iter().all(|page| page.breadcrumb.is_none()));
+    }
+
+    #[test]
+    fn root_label_and_fixed_rows_persist_in_submenus() {
+        let config: Config = serde_yaml::from_str(&format!("show_breadcrumbs: true\nbreadcrumb_root: Desktop\nrow_height: 16\n{MENU}")).unwrap();
+        let mut menu = Menu::new(&config).unwrap();
+        assert_eq!(menu.pages[0].breadcrumb.as_ref().unwrap().layout.text(), "Desktop");
+        menu.navigate_to_key_sequence("w r").unwrap();
+        assert_eq!(menu.pages[menu.cur_page].breadcrumb.as_ref().unwrap().layout.text(), "Desktop » Windows & <tools> » Resize");
+        assert!(menu.pages.iter().all(|page| page.item_height == 16.0));
+    }
+
+    #[test]
+    fn border_title_and_footer_have_separate_rows_and_navigation() {
+        let config: Config = serde_yaml::from_str(&format!("show_breadcrumbs: true\nbreadcrumb_root: Desktop\nrow_height: 16\npadding: 8\nborder_width: 2\n{MENU}")).unwrap();
+        let mut menu = Menu::new(&config).unwrap();
+        let title = menu.pages[0].breadcrumb.as_ref().unwrap();
+        assert_eq!(menu.border_top(), (title.height / 2.0).floor());
+        assert_eq!(menu.height(&config), 32.0 + menu.border_top() + 16.0 + 20.0);
+        let footer = menu.footer.as_ref().unwrap();
+        assert_eq!(footer.iter().map(|part| part.layout.text().to_string()).collect::<String>(), "󱊷 close  󰁮 back");
+        assert!(menu.width(&config) >= footer.iter().map(|part| part.width).sum::<f64>() + 20.0);
+        assert!(matches!(menu.get_action(ModifierState::default(), xkb::Keysym::BackSpace), Some(Action::Quit)));
+        menu.navigate_to_key_sequence("w").unwrap();
+        assert!(matches!(menu.get_action(ModifierState::default(), xkb::Keysym::BackSpace), Some(Action::Submenu(0))));
+        assert!(matches!(menu.get_action(ModifierState::default(), xkb::Keysym::Escape), Some(Action::Quit)));
+    }
+
+    fn render_pixels(config: &Config) -> Vec<u8> {
+        let menu = Menu::new(config).unwrap();
+        let mut surface = cairo::ImageSurface::create(
+            cairo::Format::ARgb32, menu.width(config).ceil() as i32, menu.height(config).ceil() as i32,
+        ).unwrap();
+        {
+            let context = cairo::Context::new(&surface).unwrap();
+            menu.render(config, &context).unwrap();
+        }
+        surface.data().unwrap().to_vec()
+    }
+
+    #[test]
+    fn render_uses_each_color_role_and_global_fallback() {
+        let fixture = r##"
+font: "DejaVu Sans Mono Bold 24"
+key_color: "#ff0000"
+desc_color: "#00ff00"
+group_color: "#0000ff"
+separator_color: "#ffff00"
+menu:
+  - {key: x, desc: Execute, cmd: "true"}
+  - {key: t, desc: Terminal, cmd: "true", desc_color: "#ff00ff"}
+  - key: a
+    desc: Accented group
+    desc_color: "#00ffff"
+    submenu:
+      - {key: n, desc: Nested, cmd: "true"}
+  - key: s
+    desc: Submenu
+    submenu:
+      - {key: y, desc: Nested, cmd: "true"}
+"##;
+        let mut config: Config = serde_yaml::from_str(fixture).unwrap();
+        let bytes = render_pixels(&config);
+        let pixels: Vec<u32> = bytes.chunks_exact(4).map(|p| u32::from_ne_bytes(p.try_into().unwrap())).collect();
+        for color in [0xffff0000, 0xff00ff00, 0xff0000ff, 0xffffff00, 0xffff00ff, 0xff00ffff] {
+            assert!(pixels.contains(&color), "missing rendered color {color:x}");
+        }
+        config.key_color = None;
+        config.desc_color = None;
+        config.group_color = None;
+        config.separator_color = None;
+        let fallback = render_pixels(&config);
+        config.key_color = Some(config.color);
+        config.desc_color = Some(config.color);
+        config.group_color = Some(config.color);
+        config.separator_color = Some(config.color);
+        assert_eq!(fallback, render_pixels(&config));
+    }
+}
