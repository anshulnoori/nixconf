+  - {key: "7", desc: Switch workspace, cmd: seven, display_group: "1…9, 0"}
+  - {key: "0", desc: Switch workspace, cmd: ten, display_group: "1…9, 0"}
+  - {key: exclam, desc: Move window, cmd: move-one, display_group: "Shift+1…9, 0"}
+  - {key: parenright, desc: Move window, cmd: move-ten, display_group: "Shift+1…9, 0"}
+  - key: j
+    desc: Apps
+    submenu:
+      - {key: "1", desc: Nested, cmd: nested, display_group: "1…9, 0"}
+"#).unwrap();
+        let mut menu = Menu::new(&config).unwrap();
+        assert_eq!(menu.pages[0].columns.len(), 2);
